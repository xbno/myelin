<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.geoff.live-recorder.app</string>
    <key>CFBundleName</key>
    <string>LiveRecorder</string>
    <key>CFBundleDisplayName</key>
    <string>LiveRecorder</string>
    <key>CFBundleExecutable</key>
    <string>LiveRecorderApp</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>
    <!-- menu-bar only: no dock icon, no main window -->
    <key>LSUIElement</key>
    <true/>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>LiveRecorder reads your current calendar event to name the meeting transcript.</string>
    <!-- The recorder runs as a child of this app, so macOS attributes its
         mic/system-audio permission to THIS bundle — these strings must live
         here too, not only in the recorder's own Info.plist. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>LiveRecorder captures your microphone to transcribe your side of a meeting locally.</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>LiveRecorder captures system audio to transcribe the other side of a meeting locally.</string>
</dict>
</plist>
